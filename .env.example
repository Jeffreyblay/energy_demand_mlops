# GridVision environment variables — copy to .env and fill in.
# .env is gitignored; NEVER commit real keys.

# EIA API v2 key (register free at https://www.eia.gov/opendata/register.php)
EIA_API_KEY=your_40_char_key_here

# Open-Meteo needs no key.

# Postgres DSN (used from Phase 4 onward; placeholder for now)
POSTGRES_DSN=postgresql://gridvision:gridvision@localhost:5432/gridvision

# MLflow tracking URI (used from Phase 2 onward)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db